# Copy this file to .env and fill in your own keys. .env is git-ignored and
# must never be committed.
#
# All three keys can be set at once -- config.yaml's llm.<provider>.active
# boolean decides which ONE is actually read at runtime. Only the active
# provider needs a real value below; the others can stay blank.
#   llm.groq.active: true   -> needs GROQ_API_KEY   (https://console.groq.com)
#   llm.gemini.active: true -> needs GOOGLE_API_KEY  (https://aistudio.google.com/app/apikey)
#   llm.openai.active: true -> needs OPENAI_API_KEY  (https://platform.openai.com/api-keys)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Non-secret tunables (confidence threshold, retrieval top_k, LLM provider/model, etc.)
# live in config.yaml, not here.
